# VocalEdge AI Backend Configurations Example
PORT=5000
JWT_SECRET=use_a_cryptographically_secure_random_string
CLIENT_ORIGIN=http://localhost:5173

# AI Outbound Providers
GROQ_API_KEY=your_groq_api_key_here

# LiveKit WebRTC Configuration
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
LIVEKIT_AGENT_NAME=assistant-033

# Optional Speech Generation Providers
OPENAI_API_KEY=optional_openai_api_key
ELEVENLABS_API_KEY=optional_elevenlabs_api_key
